# Google Gemini API key for LLM reasoning, prompts, and agent workflows
# Get it from: https://aistudio.google.com/apikey (FREE tier available)
GOOGLE_API_KEY=your_google_api_key_here

# SerpAPI key for Google Maps directions and traffic data
# Get it from: https://serpapi.com/ (FREE tier: 100 searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Tavily API key for web search (events, road closures)
# Get it from: https://tavily.com/ (FREE tier available)
TAVILY_API_KEY=your_tavily_api_key_here

# WeatherAPI key for weather forecasts and alerts
# Get it from: https://www.weatherapi.com/ (FREE tier: 1M calls/month)
OPEN_WEATHER=your_weatherapi_key_here

# Gemini model to use (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite
